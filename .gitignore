# ====================================================
# .gitignore untuk Rekap Stok Barang (Netlify & GitHub)
# ====================================================

# 1. Dependensi Node.js (Netlify akan menjalankan npm install sendiri)
node_modules/

# 2. File Rahasia & Environment (Jangan commit file .env asli ke GitHub!)
.env
.env.local
.env.*.local
!.env.example

# 3. Database SQLite lokal & jurnal transaksi
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# 4. Netlify folder build & cache lokal
.netlify/
.netlify-build/

# 5. Log & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Sistem Operasi & IDE / Text Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
